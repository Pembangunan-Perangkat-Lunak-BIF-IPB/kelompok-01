  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Tindakan primary dari primitive Button; minimum 44 px.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Analisis Baru</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 18px;border:1px solid transparent;border-radius:var(--gp-radius-control);font-family:var(--gp-body);font-size:14px;font-weight:600;line-height:1.4;text-decoration:none;white-space:normal;cursor:pointer;transition:background var(--gp-duration),color var(--gp-duration),transform var(--gp-motion-fast) var(--gp-ease);background:var(--gp-brand);color:var(--gp-surface);}.ds-button-primary:hover{background:var(--gp-brand-hover);}.ds-button-primary:focus-visible{outline:3px solid var(--gp-focus);outline-offset:4px}.ds-button-primary:disabled{opacity:.55;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none!important}}.ds-button-primary:active:not(:disabled){transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-button-primary:active:not(:disabled){transform:none}}\nbutton{min-height:48px;font-size:15px}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Tindakan secondary dari primitive Button; minimum 44 px.",
      "html": "<button class=\"ds-button-secondary\" type=\"button\">Sebelumnya</button>",
      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 18px;border:1px solid transparent;border-radius:var(--gp-radius-control);font-family:var(--gp-body);font-size:14px;font-weight:600;line-height:1.4;text-decoration:none;white-space:normal;cursor:pointer;transition:background var(--gp-duration),color var(--gp-duration),transform var(--gp-motion-fast) var(--gp-ease);background:var(--gp-surface);color:var(--gp-text);border-color:var(--gp-border);}.ds-button-secondary:hover{background:var(--gp-subtle);}.ds-button-secondary:focus-visible{outline:3px solid var(--gp-focus);outline-offset:4px}.ds-button-secondary:disabled{opacity:.55;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none!important}}.ds-button-secondary:active:not(:disabled){transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-button-secondary:active:not(:disabled){transform:none}}\nbutton{min-height:48px;font-size:15px}"
    },
    {
      "name": "Ghost button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Tindakan ghost dari primitive Button; minimum 44 px.",
      "html": "<button class=\"ds-button-ghost\" type=\"button\">Lihat riwayat</button>",
      "css": ".ds-button-ghost{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 18px;border:1px solid transparent;border-radius:var(--gp-radius-control);font-family:var(--gp-body);font-size:14px;font-weight:600;line-height:1.4;text-decoration:none;white-space:normal;cursor:pointer;transition:background var(--gp-duration),color var(--gp-duration),transform var(--gp-motion-fast) var(--gp-ease);background:transparent;color:var(--gp-link);}.ds-button-ghost:hover{background:var(--gp-subtle);}.ds-button-ghost:focus-visible{outline:3px solid var(--gp-focus);outline-offset:4px}.ds-button-ghost:disabled{opacity:.55;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-button-ghost{transition:none!important}}.ds-button-ghost:active:not(:disabled){transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-button-ghost:active:not(:disabled){transform:none}}\nbutton{min-height:48px;font-size:15px}"
    },
    {
      "name": "Analysis name field",
      "kind": "input",
      "refersTo": "input",
      "description": "Input berlabel dengan tepi kontrol, error dan disabled.",
      "html": "<div class=\"ds-field\"><label for=\"ds-analysis-name\">Nama analisis</label><input id=\"ds-analysis-name\" class=\"ds-input\" type=\"text\" /></div>",
      "css": ".ds-field{display:grid;gap:7px;color:var(--gp-text);font-family:var(--gp-body);font-size:14px}.ds-field label{font-weight:600}.ds-input{width:100%;min-height:46px;padding:10px 13px;background:var(--gp-surface);color:var(--gp-text);border:1px solid var(--gp-control-border);border-radius:var(--gp-radius-control);font-family:var(--gp-body);font-size:14px;line-height:1.5}.ds-input:focus-visible{outline:3px solid var(--gp-focus);outline-offset:4px}.ds-input::placeholder{color:var(--gp-muted);opacity:1}.ds-input[aria-invalid=true]{border-color:var(--gp-danger)}.ds-input:disabled{opacity:.6}\ninput{min-height:50px;font-size:16px}"
    },
    {
      "name": "Identity navigation",
      "kind": "nav",
      "description": "Empat tujuan horizontal, active page tinta botani dan grid mobile empat tujuan.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navigasi utama\"><a href=\"/\" class=\"ds-nav-link\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"></path><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path></svg>Beranda</a><a href=\"/dashboard\" class=\"ds-nav-link\" aria-current=\"page\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect width=\"7\" height=\"9\" x=\"3\" y=\"3\" rx=\"1\"></rect><rect width=\"7\" height=\"5\" x=\"14\" y=\"3\" rx=\"1\"></rect><rect width=\"7\" height=\"9\" x=\"14\" y=\"12\" rx=\"1\"></rect><rect width=\"7\" height=\"5\" x=\"3\" y=\"16\" rx=\"1\"></rect></svg>Dashboard</a><a href=\"/riwayat\" class=\"ds-nav-link\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8\"></path><path d=\"M3 3v5h5\"></path><path d=\"M12 7v5l4 2\"></path></svg>Riwayat</a><a href=\"/analisis-baru\" class=\"ds-nav-link\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2\"></path><path d=\"M6.453 15h11.094\"></path><path d=\"M8.5 2h7\"></path></svg>Analisis Baru</a></nav>",
      "css": ".ds-nav{display:flex;justify-content:center;gap:4px;padding:20px;background:var(--gp-rail);font-family:var(--gp-body)}.ds-nav-link{display:flex;align-items:center;gap:12px;min-height:48px;padding:12px 14px;border-radius:4px;color:#c8dae6;font-size:14px;font-weight:500;line-height:1.6;text-decoration:none;transition:background var(--gp-duration)}.ds-nav-link:hover{background:#23485f;color:#fff}.ds-nav-link[aria-current=page]{background:var(--gp-rail-selected);color:#f0f4de}.ds-nav-link[aria-current=page] svg{stroke-width:2.25}.ds-nav-link:focus-visible{outline:3px solid var(--gp-focus);outline-offset:4px}@media(max-width:640px){.ds-nav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:3px;padding:16px}.ds-nav-link{flex-direction:column;justify-content:center;min-height:60px;padding:8px 3px;gap:5px;font-size:11px;line-height:1.3;text-align:center;white-space:normal}.ds-nav-link svg{width:15px;flex-shrink:0}}@media(prefers-reduced-motion:reduce){.ds-nav-link{transition:none!important}}"
    },
    {
      "name": "Completed status",
      "kind": "chip",
      "refersTo": "status-completed",
      "description": "Status backend dengan teks dan titik; bukan input interaktif.",
      "html": "<span class=\"ds-status\" title=\"Selesai\"><span class=\"ds-status-dot\" aria-hidden=\"true\"></span>Completed</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:7px;padding:4px 10px;border-radius:5px;font-family:var(--gp-body);font-size:12px;font-weight:600;line-height:1.6;white-space:nowrap;background:var(--gp-success-bg);color:var(--gp-success)}.ds-status-dot{width:6px;height:6px;border-radius:50%;background:currentColor}.ds-status{transition:background var(--gp-duration),color var(--gp-duration)}@media(prefers-reduced-motion:reduce){.ds-status{transition:none!important}}"
    },
    {
      "name": "Submission review",
      "kind": "card",
      "refersTo": "review-summary",
      "description": "Ringkasan review pada kolom pengiriman, tanpa kartu tambahan. Current depth refinement: 16px radius and panel shadow; see workspace.css final cascade.",
      "html": "<section class=\"ds-summary\"><h2>Ringkasan sebelum dikirim</h2><p>Berkas: Belum dipilih</p></section>",
      "css": ".ds-summary{padding:0;margin:0 0 22px;border-radius:0;background:none;color:var(--gp-text);font-family:var(--gp-body);font-size:14px;line-height:1.8}.ds-summary h2{font-family:var(--gp-heading);font-size:17px;font-weight:600;letter-spacing:-.025em;margin:0 0 12px}.ds-summary p{margin:0}"
    },
    {
      "name": "Scientific table frame",
      "kind": "custom",
      "refersTo": "table-frame",
      "description": "Tabel ilmiah dengan scroll region keyboard dan batas kolom alel. Tidak memuat hasil contoh.",
      "html": "<div class=\"ds-table-frame\"><div class=\"ds-table-scroll\" role=\"region\" aria-label=\"Varian hasil analisis\" tabindex=\"0\"><table class=\"ds-scientific-table\"><caption>Record varian sesuai filter aktif</caption><thead><tr><th scope=\"col\">Kromosom</th><th scope=\"col\">Posisi (bp)</th><th scope=\"col\">REF</th><th scope=\"col\">ALT</th><th scope=\"col\">QUAL</th><th scope=\"col\">FORMAT/DP</th><th scope=\"col\">GT asli</th><th scope=\"col\">FILTER</th><th scope=\"col\">Tipe</th></tr></thead><tbody></tbody></table></div><p class=\"ds-table-hint\">Geser tabel untuk melihat seluruh kolom pada layar kecil.</p></div>",
      "css": ".ds-table-frame{border:1px solid var(--gp-border);border-radius:4px;overflow:hidden;background:var(--gp-surface);color:var(--gp-text);font-family:var(--gp-body)}.ds-table-scroll{overflow-x:auto}.ds-table-scroll:focus-visible{outline:3px solid var(--gp-focus);outline-offset:4px}.ds-scientific-table{width:100%;min-width:980px;border-collapse:collapse;text-align:left;font-size:14px}.ds-scientific-table caption{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.ds-scientific-table th{padding:15px 18px;background:var(--gp-subtle);color:var(--gp-muted);font-size:12px;font-weight:600;white-space:nowrap}.ds-scientific-table td{padding:18px;border-top:1px solid var(--gp-border);vertical-align:top;font-family:var(--gp-data);font-size:12px;font-variant-numeric:tabular-nums}.ds-scientific-table tbody tr:hover{background:var(--gp-subtle)}.ds-scientific-table .ds-allele{min-width:100px;max-width:320px;word-break:normal;overflow-wrap:anywhere}.ds-table-hint{font-size:12px;padding:10px 18px;color:var(--gp-muted);border-top:1px solid var(--gp-border)}@media(min-width:768px){.ds-table-hint{display:none}}\n.frame{border-radius:14px}"
    },
    {
      "name": "Context help panel",
      "kind": "custom",
