  "narrative": {
    "northStar": "Stasiun riset GenoPath",
    "overview": "Ruang kerja kampus untuk analisis genom yang menempatkan sampel, status dan tindakan berikutnya di depan. Rail tinta biru memberi identitas; kanvas porselen, garis pembagi dan tipografi terukur menjaga halaman kerja tenang. Beranda lebih ekspresif melalui judul editorial dan foto kampus asli.\n\nDokumen ini merekam implementasi M11, bukan pemulihan Hi-Fi/Lo-Fi lama atau komposisi final semua halaman. Arah code-led sudah dipilih pengguna; penerimaan visual akhir masih menunggu review preview. PRODUCT.md memegang kebenaran produk, surface brief memegang strategi halaman, dan token di frontend/src/styles/tokens.css memegang nilai runtime.",
    "keyCharacteristics": [
      "Rail gelap, kanvas luas dan bagian data bergaris.",
      "Sora untuk orientasi, Instrument Sans untuk kerja, monospace untuk nilai ilmiah.",
      "Status nyata dan tindakan eksplisit; tidak membuat metrik atau hasil contoh.",
      "Satu fondasi light/dark untuk halaman yang dikerjakan tiga developer."
    ],
    "rules": [
      {
        "name": "The Semantic Pair Rule",
        "body": "Pakai pasangan warna per mode dari sumber token. Border kontrol membedakan field dari kanvas; border struktural hanya mengatur pembagian ruang.",
        "section": "colors"
      },
      {
        "name": "The Scientific Integrity Rule",
        "body": "Monospace dan lebar kolom membantu membaca data, tanpa menyingkat, menyusun ulang atau mengubah REF, ALT, GT, QUAL, DP dan null.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Halaman kerja memakai lapisan tonal dan garis; bayangan hanya memberi jarak pada bantuan mengambang. Scene tim asli tetap menjadi pengecualian lokal yang dilindungi.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do gunakan primitive bersama dan token semantik agar light/dark tetap berpasangan.",
      "Do pertahankan focus terlihat, label, pesan status, akses keyboard, zoom dan rekomendasi target minimum 44 px.",
      "Do tampilkan loading, kosong, gagal, retry dan data stale sesuai keadaan API yang sebenarnya.",
      "Do pertahankan aset identitas, mapping kontributor dan interaksi normal tim; sediakan alternatif reduced-motion.",
      "Do koordinasikan perubahan shell, token dan primitive melalui integrator sesuai frontend/README.md."
    ],
    "donts": [
      "Don't membuat dummy data, persentase progress, grafik atau temuan biologis untuk mengisi layar.",
      "Don't menghilangkan ALT multiallelic, pemisah GT, null atau batas filter dan ekspor demi kerapian visual.",
      "Don't menggandakan Button, tabel atau shell dengan gaya baru pada setiap halaman.",
      "Don't menjadikan glass, badge uppercase dan bayangan scene tim sebagai pola baru halaman kerja.",
      "Don't mengubah backend, JWT, ownership, gate privat atau perilaku submission dalam pekerjaan desain."
    ]
  }
}
