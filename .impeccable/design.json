      "html": "<div class=\"ds-table-frame\"><div class=\"ds-table-scroll\" role=\"region\" aria-label=\"Varian hasil analisis\" tabindex=\"0\"><table class=\"ds-scientific-table\"><caption>Record varian sesuai filter aktif</caption><thead><tr><th scope=\"col\">Kromosom</th><th scope=\"col\">Posisi (bp)</th><th scope=\"col\">REF</th><th scope=\"col\">ALT</th><th scope=\"col\">QUAL</th><th scope=\"col\">FORMAT/DP</th><th scope=\"col\">GT asli</th><th scope=\"col\">FILTER</th><th scope=\"col\">Tipe</th></tr></thead><tbody></tbody></table></div><p class=\"ds-table-hint\">Geser tabel untuk melihat seluruh kolom pada layar kecil.</p></div>",
