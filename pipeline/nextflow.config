manifest {
    name = 'GenoPath modular single-end workflow'
    nextflowVersion = '>=24.10.0'
}
params {
    reads = null
    reference = null
    outdir = null
    sample_name = null
    alignment_strategy = null
    alignment_adapter = null
    fastp_executable = null
    samtools_executable = null
    bcftools_executable = null
    threads = 1
    ploidy = null
}
profiles {
    local {
        process.executor = 'local'
        process.maxForks = 1
        process.errorStrategy = 'terminate'
        process.shell = ['/bin/bash', '-euo', 'pipefail']
    }
}
