manifest {
    name = 'GenoPath modular single-end workflow'
    nextflowVersion = '>=24.10.0'
}
params {
    reads = null
    reference = null
    outdir = null
    sample_name = null
    alignment_strategy = null
    alignment_adapter = null
    fastp_executable = null
    samtools_executable = null
    bcftools_executable = null
    bowtie2_executable = null
    bowtie2_inspect_executable = null
    bowtie2_index_prefix = null
    minimum_qual = null
    minimum_dp = null
    threads = 1
    ploidy = null
}
profiles {
    local {
        process {
            executor = 'local'
            maxForks = 1
            memory = '1 GB'
            errorStrategy = 'terminate'
            shell = ['/bin/bash', '-euo', 'pipefail']
            withName: ALIGN { memory = '4 GB' }
        }
        executor.cpus = 4
        executor.memory = '6 GB'
        executor.queueSize = 1
    }
}
